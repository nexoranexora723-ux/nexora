// NEXORA — Import Platform Schema
// El corazón es ImportRequest (Solicitud) con 12 estados de lifecycle

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE — Empresa, Usuarios, Sesiones, Auditoría
// ============================================================================

model Company {
  id             String   @id @default(cuid())
  legalName      String   @map("legal_name")
  commercialName String   @map("commercial_name")
  nit            String?  @unique
  email          String?
  phone          String?
  country        String?  @default("CO")
  currencyCode   String   @default("USD") @map("currency_code")
  timezone       String?  @default("America/Bogota")
  logoUrl        String?  @map("logo_url")
  website        String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users    User[]
  settings Setting[]

  @@map("companies")
}

model User {
  id           String    @id @default(cuid())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  password     String    // bcrypt hash
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  role         String    @default("CLIENT") // CLIENT | RESELLER | EMPLOYEE | ADMIN | SUPER_ADMIN
  position     String?   // cargo (for employees)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  companyId    String    @map("company_id")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company      Company       @relation(fields: [companyId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  requests     ImportRequest[] @relation("RequestClient")
  assignedReqs ImportRequest[] @relation("RequestAssignee")
  quotes       Quote[]       @relation("QuoteAssignee")
  notifications Notification[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  String?
  ipAddress String?  @map("ip_address")
  result    String   @default("SUCCESS")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@map("settings")
}

// ============================================================================
// CATÁLOGO — Productos importables
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  longDescription String? @map("long_description") // rich text for detail page
  brandId       String?  @map("brand_id")
  categoryId    String?  @map("category_id")
  supplierId    String?  @map("supplier_id")
  imageUrl      String?  @map("image_url")
  images        String?  // JSON array of image URLs
  videoUrl      String?  @map("video_url") // YouTube or direct video URL
  referenceUrl  String?  @map("reference_url")
  estimatedCost Float?   @map("estimated_cost")
  suggestedPrice Float?  @map("suggested_price")
  currencyCode  String   @default("USD") @map("currency_code")
  status        String   @default("ACTIVE")
  isFeatured    Boolean  @default(false) @map("is_featured")
  specs         String?  // JSON: [{label, value}, ...]
  features      String?  // JSON: ["feature1", "feature2", ...]
  rating        Float?   @default(4.0)
  reviewCount   Int      @default(0) @map("review_count")
  soldCount     Int      @default(0) @map("sold_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  brand       Brand?     @relation(fields: [brandId], references: [id])
  category    Category?  @relation(fields: [categoryId], references: [id])
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
  reviews     Review[]

  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@map("products")
}

// ============================================================================
// REVIEWS — Calificaciones y reseñas de productos por usuarios
// ============================================================================

model Review {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  userId      String?  @map("user_id") // nullable: anónimos también pueden opinar
  userRole    String?  @map("user_role") // CLIENT | RESELLER | GUEST
  userName    String   @map("user_name") // snapshot del nombre visible
  orderId     String?  @map("order_id") // si la reseña es de una compra verificada
  rating      Int      // 1-5
  title       String
  comment     String
  images      String?  // JSON array de URLs
  verified    Boolean  @default(false) @map("verified") // compra verificada
  status      String   @default("ACTIVE") // ACTIVE | HIDDEN
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ============================================================================
// PROVEEDORES — Fabricantes chinos con calificación multifactor
// ============================================================================

model Supplier {
  id              String   @id @default(cuid())
  companyName     String   @map("company_name")
  contactName     String?  @map("contact_name")
  whatsapp        String?
  wechat          String?
  email           String?
  website         String?
  yupoo           String?
  alibaba         String?
  country         String?  @default("CN")
  city            String?
  address         String?
  moq             Int?     // minimum order quantity
  paymentMethods  String?  @map("payment_methods")
  shippingMethods String?  @map("shipping_methods")
  warranty        String?
  leadTime        Int?     @map("lead_time") // días
  productionTime  Int?     @map("production_time") // días
  oem             Boolean  @default(false)
  odm             Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLISTED
  riskLevel       String   @default("MEDIUM") @map("risk_level") // LOW | MEDIUM | HIGH
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ratings   SupplierRating[]
  quotes    Quote[]
  products  Product[]
  imports   Import[]

  @@index([status])
  @@index([riskLevel])
  @@map("suppliers")
}

model SupplierRating {
  id                String   @id @default(cuid())
  supplierId        String   @map("supplier_id")
  communicationScore Int     @map("communication_score")
  qualityScore      Int      @map("quality_score")
  priceScore        Int      @map("price_score")
  shippingScore     Int      @map("shipping_score")
  warrantyScore     Int      @map("warranty_score")
  trustScore        Int      @map("trust_score")
  overallScore      Float    @map("overall_score")
  review            String?
  createdAt         DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_ratings")
}

// ============================================================================
// SOLICITUDES — EL CORAZÓN DE NEXORA
// Una solicitud es el punto de partida de toda importación.
// Lifecycle de 12 estados: NUEVA → ANALIZANDO → BUSCANDO_PROVEEDOR →
// COTIZACION_RECIBIDA → COTIZACION_ENVIADA → ESPERANDO_APROBACION →
// PAGO_RECIBIDO → COMPRA_REALIZADA → PRODUCCION → EN_TRANSITO →
// ENTREGADO → CERRADO
// ============================================================================

model ImportRequest {
  id              String    @id @default(cuid())
  number          String    @unique // NX-2025-000001
  clientId        String    @map("client_id")
  assignedToId    String?   @map("assigned_to_id")

  // Qué quiere importar el cliente
  productName     String    @map("product_name")
  description     String?
  category        String?   // Tecnología | Hogar | Moda | Belleza | Herramientas | Mascotas | Automotriz | Otro
  purpose         String?   // personal | resale | business
  quantity        Int       @default(1)
  budget          Float?    // presupuesto del cliente
  currencyCode    String    @default("USD") @map("currency_code")

  // Referencias del cliente
  referenceUrl    String?   @map("reference_url") // link a Alibaba/AliExpress/etc
  referenceImages String?   @map("reference_images") // JSON array of image URLs

  // Detalles
  details         String?   // color, talla, material, marca, empaque
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT

  // Análisis de NAIOS
  naiosSummary    String?   @map("naios_summary")
  naiosCategory   String?   @map("naios_category")
  naiosPriority   String?   @map("naios_priority")

  // Estado actual
  status          String    @default("NUEVA")
  // NUEVA | ANALIZANDO | BUSCANDO_PROVEEDOR | COTIZACION_RECIBIDA |
  // COTIZACION_ENVIADA | ESPERANDO_APROBACION | PAGO_RECIBIDO |
  // COMPRA_REALIZADA | PRODUCCION | EN_TRANSITO | ENTREGADO | CERRADO

  notes           String?   // notas internas del admin

  // Estado del panel admin (flujo simplificado de pedidos)
  // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED
  adminStatus     String?  @map("admin_status")
  trackingNumber  String?  @map("tracking_number")
  paymentMethod   String?  @map("payment_method")
  shippingAddress String?  @map("shipping_address")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  closedAt        DateTime? @map("closed_at")

  client       User               @relation("RequestClient", fields: [clientId], references: [id])
  assignee     User?              @relation("RequestAssignee", fields: [assignedToId], references: [id])
  quotes       Quote[]
  imports      Import[]
  statusHistory RequestStatusHistory[]
  attachments  RequestAttachment[]
  notifications Notification[]

  @@index([clientId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@map("import_requests")
}

model RequestStatusHistory {
  id          String   @id @default(cuid())
  requestId   String   @map("request_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  changedById String?  @map("changed_by_id")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  request ImportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_status_history")
}

model RequestAttachment {
  id          String   @id @default(cuid())
  requestId   String   @map("request_id")
  type        String   // image | link | document
  url         String
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")

  request ImportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_attachments")
}

// ============================================================================
// COTIZACIONES — Quote del proveedor para una solicitud
// ============================================================================

model Quote {
  id            String    @id @default(cuid())
  number        String    @unique // COT-2025-000001
  requestId     String    @map("request_id")
  supplierId    String    @map("supplier_id")
  assignedToId  String?   @map("assigned_to_id")

  unitPrice     Float     @map("unit_price")
  quantity      Int
  subtotal      Float
  shippingCost  Float     @default(0) @map("shipping_cost")
  tax           Float     @default(0)
  total         Float
  currencyCode  String    @default("USD") @map("currency_code")

  leadTime      Int?      @map("lead_time") // días de producción + envío
  warranty      String?
  validity      DateTime? // validez de la cotización

  status        String    @default("RECIBIDA")
  // RECIBIDA | ENVIADA_AL_CLIENTE | APROBADA | RECHAZADA | EXPIRADA

  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  request   ImportRequest @relation(fields: [requestId], references: [id])
  supplier  Supplier      @relation(fields: [supplierId], references: [id])
  assignee  User?         @relation("QuoteAssignee", fields: [assignedToId], references: [id])
  imports   Import[]

  @@index([requestId])
  @@index([supplierId])
  @@index([status])
  @@map("quotes")
}

// ============================================================================
// IMPORTACIONES — Seguimiento del proceso de importación
// Cuando una cotización se aprueba + se recibe el pago → se crea Import
// ============================================================================

model Import {
  id              String    @id @default(cuid())
  number          String    @unique // IMP-2025-000001
  requestId       String    @map("request_id")
  quoteId         String?   @map("quote_id")
  supplierId      String    @map("supplier_id")

  // Costos reales
  productCost     Float     @map("product_cost")
  shippingCost    Float     @default(0) @map("shipping_cost")
  customsCost     Float     @default(0) @map("customs_cost") // costos de aduana
  otherCosts      Float     @default(0) @map("other_costs")
  totalCost       Float     @map("total_cost")
  salePrice       Float     @map("sale_price") // precio al cliente
  profit          Float     @default(0) // salePrice - totalCost
  currencyCode    String    @default("USD") @map("currency_code")

  // Tracking
  status          String    @default("COMPRA_REALIZADA")
  // COMPRA_REALIZADA | PRODUCCION | ENVIADO | EN_TRANSITO |
  // EN_ADUANA | RECIBIDO_BODEGA | ENTREGADO | CANCELADO

  // Fechas de tracking
  purchasedAt     DateTime? @map("purchased_at")
  productionEndsAt DateTime? @map("production_ends_at")
  shippedAt       DateTime? @map("shipped_at")
  arrivedAt       DateTime? @map("arrived_at")
  deliveredAt     DateTime? @map("delivered_at")

  // Logística
  carrier         String?   // DHL, FedEx, etc
  trackingNumber  String?   @map("tracking_number")
  billOfLading    String?   @map("bill_of_lading") // B/L
  incoterm        String?   @default("FOB") // FOB | CIF | EXW | DDP

  // Documentos
  documents       String?   // JSON array of {name, url, type}

  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  request   ImportRequest @relation(fields: [requestId], references: [id])
  quote     Quote?        @relation(fields: [quoteId], references: [id])
  supplier  Supplier      @relation(fields: [supplierId], references: [id])

  @@index([requestId])
  @@index([supplierId])
  @@index([status])
  @@map("imports")
}

// ============================================================================
// FINANZAS — Transacciones
// ============================================================================

model Transaction {
  id          String   @id @default(cuid())
  type        String   // INCOME | EXPENSE
  category    String   // SALES | PURCHASE | SHIPPING | CUSTOMS | SALARY | MARKETING | OTHER
  description String
  amount      Float
  currencyCode String  @default("USD") @map("currency_code")
  reference   String?  // request number, quote number, etc
  requestId   String?  @map("request_id")
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([category])
  @@index([date])
  @@map("transactions")
}

// ============================================================================
// NOTIFICACIONES
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // info | success | warning | error | system | request | quote | import
  priority    String   @default("MEDIUM")
  title       String
  message     String
  data        String?  // JSON
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request ImportRequest?   @relation(fields: [requestId], references: [id])

  requestId String? @map("request_id")

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

// ============================================================================
// NAIOS — Recomendaciones y conversaciones
// ============================================================================

model NaiosRecommendation {
  id          String   @id @default(cuid())
  type        String   // ALERT | OPPORTUNITY | RISK | INSIGHT
  severity    String   @default("MEDIUM")
  title       String
  description String
  module      String   // requests | quotes | imports | suppliers | finance
  entityId    String?  @map("entity_id")
  action      String?
  status      String   @default("PENDING") // PENDING | DISMISSED | APPLIED
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("naios_recommendations")
}

model NaiosConversation {
  id        String   @id @default(cuid())
  role      String   // user | assistant
  content   String
  module    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("naios_conversations")
}

model RequestMessage {
  id          String   @id @default(cuid())
  requestId   String   @map("request_id")
  userId      String   @map("user_id")
  role        String   // client | admin | naios
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([requestId])
  @@map("request_messages")
}

// #34 Rate limiting tracking
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rate_limits")
}

// #13 Referral tracking
model Referral {
  id          String   @id @default(cuid())
  referrerId  String   @map("referrer_id")
  referredEmail String @map("referred_email")
  status      String   @default("PENDING")
  reward      Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([referrerId])
  @@map("referrals")
}

// #11 Supplier portal access
model SupplierAccess {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  token      String   @unique
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("supplier_access")
}

// #17 API Keys for public API
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @unique @map("key_hash")
  scopes    String   @default("[]")
  status    String   @default("ACTIVE")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}

// #32 NAIOS metrics tracking
model NaiosMetric {
  id         String   @id @default(cuid())
  type       String   // tokens_in | tokens_out | cost | latency
  value      Float
  model      String?
  agentId    String?  @map("agent_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("naios_metrics")
}
